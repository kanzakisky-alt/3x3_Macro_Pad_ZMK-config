#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    // 📍 HARDWARE PINS SECTION
    // This tells ZMK exactly which physical holes on your Seeed Xiao are soldered to what!
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row";

        // 🟢 Solder your ROW wires to these physical digital pins:
        row-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 0 (Top keys)
            , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 1 (Middle keys)
            , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row 2 (Bottom keys)
            ;

        // 🔵 Solder your COLUMN wires to these physical digital pins:
        col-gpios
            = <&xiao_d 3 GPIO_ACTIVE_HIGH> // Column 0 (Left vertical line of keys)
            , <&xiao_d 4 GPIO_ACTIVE_HIGH> // Column 1 (Middle vertical line of keys)
            , <&xiao_d 5 GPIO_ACTIVE_HIGH> // Column 2 (Right vertical line of keys)
            , <&xiao_d 6 GPIO_ACTIVE_HIGH> // Column 3 (The encoder click-switch pin!)
            ;
    };

    // 🎛️ ROTARY ENCODER PINS SECTION
    // Solder the two spinning signal legs of your wheel encoder here
    encoder: encoder {
        compatible = "alps,ec11";
        label = "ENCODER";
        a-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // Pin A / CLK
        b-gpios = <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; // Pin B / DT
        steps = <8>; // Optimized for your 8mm wheel sensitivity
    };

    // This activates the encoder inside ZMK's engine
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        
        // LAYER 0: BASE
        layer_base_sensor { bindings = <&kp C_VOL_UP &kp C_VOL_DN>, <&to 1 &none>; };

        // LAYER 1: CHROME
        layer_chrome_sensor { bindings = <&kp LC(TAB) &kp LC(LS(TAB))>, <&to 2 &to 0>; };

        // LAYER 2: REMOTE CONTROLLER
        layer_remote_sensor { bindings = <&kp RIGHT &kp LEFT>, <&to 3 &to 1>; };

        // LAYER 3: GAME
        layer_game_sensor { bindings = <&kp C_AC_SCROLL_UP &kp C_AC_SCROLL_DOWN>, <&to 4 &to 2>; };

        // LAYER 4: FUN/FIDDLE SCREEN
        layer_fun_sensor { bindings = <&none &none>, <&none &to 3>; };
    };

    // 🧠 SOFTWARE KEYBINDS SECTION
    behaviors {
        win_mod: windows_maximize_minimize {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(UP)>, <&kp LG(DOWN)>;
            mods = <(MOD_LSHIFT|MOD_RSHIFT)>;
        };

        open_notepad: open_notepad_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&kp LG(R)>
                , <&zmk,delay_ms 100>
                , <&kp N &kp O &kp T &kp E &kp P &kp A &kp D>
                , <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE WORKSPACE (Media & Everyday Tools)
        base_layer {
            label = "Base";
            bindings = <
                &kp C_PP         &kp C_NEXT   &win_mod      &none
                &open_notepad    &kp CALC     &kp LS(LC(C))
                &kp LC(X)        &kp LC(C)    &kp LC(V)
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // LAYER 1: CHROME & TEXT EDITORS
        chrome_layer {
            label = "Chrome";
            bindings = <
                &kp LC(W)        &kp LC(T)    &kp LC(LS(T)) &none
                &kp LSHIFT       &kp LC(LEFT) &kp LC(RIGHT)
                &kp LC(X)        &kp LC(C)    &kp LC(V)
            >;
            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        // LAYER 2: REMOTE CONTROLLER (Canva Presentation / Video Control)
        remote_layer {
            label = "Remote";
            bindings = <
                &kp C_PREV       &kp C_PP     &kp C_NEXT    &none
                &kp C_VOL_DN     &kp C_MUTE   &kp C_VOL_UP
                &kp HOME         &kp C        &kp END       
            >;
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        // LAYER 3: GAME MODE
        game_layer {
            label = "Game";
            bindings = <
                &kp N1           &kp UP       &kp N2        &kp ESC  
                &kp LEFT         &kp DOWN     &kp RIGHT
                &kp LCTRL        &kp LSHIFT   &kp SPACE
            >;
            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        // LAYER 4: FUN / SCREEN FIDDLE LAYER
        fun_layer {
            label = "Fiddle";
            bindings = <
                &none            &none        &none         &none
                &none            &none        &none
                &none            &none        &none
            >;
            sensor-bindings = <&none &none>;
        };
    };
};
