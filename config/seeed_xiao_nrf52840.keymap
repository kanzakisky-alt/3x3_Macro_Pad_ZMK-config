#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Define our layers
#define LAYER_BASE       0
#define LAYER_CHROME     1
#define LAYER_REMOTE     2
#define LAYER_GAME       3
#define LAYER_FUN        4

/ {
    behaviors {
        // Window Maximize/Minimize toggle behavior for the top right key
        win_mod: windows_maximize_minimize {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LG(UP)>, <&kp LG(DOWN)>;
            mods = <(MOD_LSHIFT|MOD_RSHIFT)>;
        };

        // 📝 Automated Hands-Free Macro: Win + R -> "notepad" -> Enter
        open_notepad: open_notepad_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings
                = <&kp LG(R)>
                , <&zmk,delay_ms 100>
                , <&kp N &kp O &kp T &kp E &kp P &kp A &kp D>
                , <&kp ENTER>;
        };
    };

    // Encoder navigation logic (Press + Spin to jump cleanly between all layers)
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        
        // LAYER 0: BASE
        layer_base_sensor {
            status = "okay";
            bindings = <&kp C_VOL_UP &kp C_VOL_DN>, <&to LAYER_CHROME &none>;
        };

        // LAYER 1: CHROME
        layer_chrome_sensor {
            status = "okay";
            bindings = <&kp LC(TAB) &kp LC(LS(TAB))>, <&to LAYER_REMOTE &to LAYER_BASE>;
        };

        // LAYER 2: REMOTE CONTROLLER
        layer_remote_sensor {
            status = "okay";
            bindings = <&kp RIGHT &kp LEFT>, <&to LAYER_GAME &to LAYER_CHROME>;
        };

        // LAYER 3: GAME
        layer_game_sensor {
            status = "okay";
            bindings = <&none &none>, <&to LAYER_FUN &to LAYER_REMOTE>;
        };

        // LAYER 4: FUN/FIDDLE SCREEN
        layer_fun_sensor {
            status = "okay";
            bindings = <&none &none>, <&none &to LAYER_GAME>; // Hold push + turn left to escape back to Game
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: BASE WORKSPACE (Media & Everyday Tools)
        base_layer {
            label = "Base";
            bindings = <
                &kp C_PP         &kp C_NEXT   &win_mod      &none
                &open_notepad    &kp CALC     &kp LS(LC(C))
                &kp LC(X)        &kp LC(C)    &kp LC(V)
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // LAYER 1: CHROME & TEXT EDITORS
        chrome_layer {
            label = "Chrome";
            bindings = <
                &kp LC(W)        &kp LC(T)    &kp LC(LS(T)) &none
                &kp LSHIFT       &kp LC(LEFT) &kp LC(RIGHT)
                &kp LC(X)        &kp LC(C)    &kp LC(V)
            >;
            sensor-bindings = <&inc_dec_kp LC(TAB) LC(LS(TAB))>;
        };

        // LAYER 2: REMOTE CONTROLLER (Canva Presentation / Video Control)
        remote_layer {
            label = "Remote";
            bindings = <
                &kp C_PREV       &kp C_PP     &kp C_NEXT    &none
                &kp C_VOL_DN     &kp C_MUTE   &kp C_VOL_UP
                &kp HOME         &kp C        &kp END        // 'C' is the default Canva hotkey to show/hide presenter notes
            >;
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        // LAYER 3: GAME MODE
        game_layer {
            label = "Game";
            bindings = <
                &kp N1           &kp UP       &kp N2        &KP ESC
                &kp LEFT         &kp DOWN     &kp RIGHT
                &kp LCTRL        &kp LSHIFT   &kp SPACE
            >;
            sensor-bindings = <&inc_dec_kp C_AC_SCROLL_UP C_AC_SCROLL_DOWN>;
        };

        // LAYER 4: FUN / SCREEN FIDDLE LAYER
        fun_layer {
            label = "Fiddle Screen";
            bindings = <
                &none            &none        &none         &none
                &none            &none        &none
                &none            &none        &none
            >;
            sensor-bindings = <&none &none>;
        };
    };
};
